# Server
NODE_ENV=development
PORT=8080

# Database (not used yet — in-memory store for now)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/velvetstreak

# Auth
JWT_ACCESS_SECRET=replace-with-256-bit-random-string
JWT_REFRESH_SECRET=replace-with-another-256-bit-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email — Gmail App Password (not used yet)
# GMAIL_USER=yourgmail@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=noreply@velvetstreak.app

# Security
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECRET=replace-with-cookie-secret
BCRYPT_ROUNDS=12
