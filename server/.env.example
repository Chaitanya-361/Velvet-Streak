# Server
NODE_ENV=development
PORT=8080

# Database
MONGO_URI=mongodb://localhost:27017/velvet-streak

# Auth
JWT_ACCESS_SECRET=replace-with-256-bit-random-string
JWT_REFRESH_SECRET=replace-with-another-256-bit-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email — Gmail App Password (not used yet)
# GMAIL_USER=yourgmail@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM=noreply@velvetstreak.app

# Security
# For deployed frontend, add the vercel domain separated by commas:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECRET=replace-with-cookie-secret
BCRYPT_ROUNDS=12
